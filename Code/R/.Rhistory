l <- function(theta, y){
mu <- theta[1]
s2 <- exp(theta[2]) #first change
N <- length(y)
ssr <-  sum((y-mu)^2)
LL <- -N*log(s2)/2 - N*log(2*pi)/2 - ssr/(2*s2)
return(-LL)
}
r <- function(theta, y){
mu <- theta[1]
s2 <- exp(theta[2]) #second change
N <- length(y)
ssr <-  sum((y-mu)^2)
gr <- c(-N*mu/s2 + sum(y)/s2, #D_mu (no change)
-N/2 + ssr/(2*s2)) #D_s2 Third change (times exp(theta2))
return(-gr)
}
h <- function(theta, y){
mu <- theta[1]
s2 <- exp(theta[2])
N <- length(y)
Sy <- sum(y)
ssr <-  sum((y-mu)^2)
D2 <- c(-N/s2, #D2_mu
(N*mu-Sy)/(s2), # D_mu,s2 4th change (times exp(theta2))
(N*mu-Sy)/(s2), #D_mu,s2 5th change (times exp(theta2))
-ssr/(2*s2)) # D2_s2 6th change
return(-matrix(D2, 2))
}
