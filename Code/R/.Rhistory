Sy <- sum(y)
ssr <-  sum((y-mu)^2)
D2 <- c(-N/s2, #D2_mu
(N*mu-Sy)/(s2^2), # D_mu,s2
(N*mu-Sy)/(s2^2), #D_mu,s2
N/(2*s2^2) - ssr/(s2^3)) # D2_s2
return(-matrix(D2, 2))
}
